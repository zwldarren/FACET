  m_Script: {fileID: 11500000, guid: 12eb7dba49ecf9044b3a9f06ba9fb05f, type: 3}
  m_Name: TrainingYard
  m_EditorClassIdentifier: FACET.Game::Facet.Game.MapAsset
  Name: Training Yard
  Width: 30
  Height: 18
  StartShapes: 150
  CoreCell: {x: 5, y: 6}
  Terrain: 
  Ore:
  - Cell: {x: 1, y: 6}
    Mineral: 1
  - Cell: {x: 2, y: 6}
    Mineral: 1
  - Cell: {x: 1, y: 7}
    Mineral: 1
  - Cell: {x: 2, y: 7}
    Mineral: 1
  - Cell: {x: 15, y: 11}
    Mineral: 1
  - Cell: {x: 16, y: 11}
    Mineral: 1
  - Cell: {x: 9, y: 11}
    Mineral: 1
  - Cell: {x: 10, y: 11}
    Mineral: 1
  SpawnPoints:
  - {x: 29, y: 8}
  Waves:
  - Intermission: 5
    Groups:
    - Kind: 0
      Count: 3
      SpawnPoint: 0
      FirstDelay: 2
      Interval: 3
      Weakness:
        NW: 1
        NE: 1
        SE: 1
        SW: 1
  - Intermission: 20
    Groups:
    - Kind: 0
      Count: 4
      SpawnPoint: 0
      FirstDelay: 2
      Interval: 2.5
      Weakness:
        NW: 1
        NE: 1
        SE: 0
        SW: 0
  Unlocked: 1
  Seed: 0
  GeneratedWaves: 0
  TutorialStarting:
  - 1
  TutorialTasks:
  - Step: 8
    Text: Press 2 to pick up a Drill - its key is glowing on the bar below.
    Hint: Click the glowing Drill key at the bottom of the screen, or press 2.
    Target: {x: 2, y: 7}
    Ghost:
    - Build: 1
      Cell: {x: 2, y: 7}
      Facing: 1
    Opens: []
    StartsWave: 0
  - Step: 0
    Text: Click the glowing ore tile behind the Core. The Drill mines circles.
    Hint: A Drill only goes on ore. Its arrow should point right, toward the Core.
    Target: {x: 2, y: 7}
    Ghost:
    - Build: 1
      Cell: {x: 2, y: 7}
      Facing: 1
    Opens:
    - 0
    StartsWave: 0
  - Step: 9
    Text: Press 1 to pick up Belts.
    Hint: Click the glowing Belt key at the bottom of the screen, or press 1.
    Target: {x: 3, y: 7}
    Ghost:
    - Build: 0
      Cell: {x: 3, y: 7}
      Facing: 1
    - Build: 0
      Cell: {x: 4, y: 7}
      Facing: 1
    Opens: []
    StartsWave: 0
  - Step: 1
    Text: Drag Belts from the Drill into the Core. Each full shape earns 1 coin.
    Hint: Hold left-click on the tile right of the Drill, drag right to the Core, let go.
    Target: {x: 3, y: 7}
    Ghost:
    - Build: 0
      Cell: {x: 3, y: 7}
      Facing: 1
    - Build: 0
      Cell: {x: 4, y: 7}
      Facing: 1
    Opens:
    - 9
    StartsWave: 0
  - Step: 10
    Text: Enemies are coming. Press 0 to pick up a Turret.
    Hint: Click the glowing Turret key at the bottom of the screen, or press 0.
    Target: {x: 18, y: 11}
    Ghost:
    - Build: 9
      Cell: {x: 18, y: 11}
      Facing: 1
    Opens: []
    StartsWave: 0
  - Step: 12
    Text: Place the Turret on the glowing tile, near the enemy path.
    Hint: Enemies walk in from the right toward the Core. A Turret covers the tiles around it.
    Target: {x: 18, y: 11}
    Ghost:
    - Build: 9
      Cell: {x: 18, y: 11}
      Facing: 1
    Opens: []
    StartsWave: 0
  - Step: 2
    Text: A Turret fires the shapes you feed it. Drill this ore, belt it in.
    Hint: Drill the ore tile left of the Turret, then one Belt pointing into the Turret.
    Target: {x: 16, y: 11}
    Ghost:
    - Build: 1
      Cell: {x: 16, y: 11}
      Facing: 1
    - Build: 0
      Cell: {x: 17, y: 11}
      Facing: 1
    Opens: []
    StartsWave: 1
  - Step: 13
    Text: Here they come! This wave is weak to full circles - hold the line.
    Hint: The shape beside the wave number is what that wave is weak to.
    Target: {x: -1, y: -1}
    Ghost: []
    Opens:
    - 2
    StartsWave: 0
  - Step: 11
    Text: The next wave is weak to a TOP HALF circle. Press 3 for a Cutter.
    Hint: Click the glowing Cutter key at the bottom of the screen, or press 3.
    Target: {x: 12, y: 11}
    Ghost:
    - Build: 2
      Cell: {x: 12, y: 11}
      Facing: 1
    Opens: []
    StartsWave: 0
  - Step: 3
    Text: Drill the left ore and belt it into the Cutter. It cuts circles in half.
    Hint: Place the Cutter facing right, as the ghost shows; it is two tiles tall.
    Target: {x: 12, y: 11}
    Ghost:
    - Build: 1
      Cell: {x: 10, y: 11}
      Facing: 1
    - Build: 0
      Cell: {x: 11, y: 11}
      Facing: 1
    - Build: 2
      Cell: {x: 12, y: 11}
      Facing: 1
    Opens: []
    StartsWave: 0
  - Step: 5
    Text: Belt each half into its own Turret. The matching half hits twice as hard!
    Hint: A Cutter stops unless a Belt leaves both of its tiles.
    Target: {x: 13, y: 11}
    Ghost:
    - Build: 0
      Cell: {x: 13, y: 11}
      Facing: 1
    - Build: 0
      Cell: {x: 13, y: 10}
      Facing: 1
    - Build: 9
      Cell: {x: 14, y: 11}
      Facing: 1
    - Build: 9
      Cell: {x: 14, y: 10}
      Facing: 1
    Opens: []
    StartsWave: 1
