  TutorialTasks:
  - Step: 8
    Text: "These enemies are weak to RIGHT halves, but this line makes TOP halves. The gun needs a different shape."
    Hint: ""
    Target: {x: 14, y: 6}
    Ghost: []
    Opens:
    StartsWave: 0
    Title: "Wrong shape"
    Focus: 09
    Reveal: 31
    AddsOre: []
  - Step: 8
    Text: "A Rotator turns a shape a quarter clockwise. One turn makes a TOP half into a RIGHT half."
    Hint: ""
    Target: {x: 14, y: 6}
    Ghost:
    - Build: 3
      Cell: {x: 14, y: 6}
      Facing: 0
    Opens: 03
    StartsWave: 0
    Title: "Meet the Rotator"
    Focus: 04
    Reveal: 0
    AddsOre: []
  - Step: 21
    Text: "Press 4, or click ROTATOR."
    Hint: ""
    Target: {x: 14, y: 6}
    Ghost:
    - Build: 3
      Cell: {x: 14, y: 6}
      Facing: 0
    Opens:
    StartsWave: 0
    Title: "Pick the Rotator"
    Focus: 05
    Reveal: 0
    AddsOre: []
  - Step: 22
    Text: "Place it in the blue gap. Press Q or E until its arrow points UP, then click."
    Hint: "Shapes leave by the arrow. If it points the wrong way, right-click to remove it and try again."
    Target: {x: 14, y: 6}
    Ghost:
    - Build: 3
      Cell: {x: 14, y: 6}
      Facing: 0
    Opens:
    StartsWave: 0
    Title: "Fill the gap"
    Focus: 04
    Reveal: 0
    AddsOre: []
  - Step: 23
    Text: "Watch the shape turn. The gun must load a RIGHT half before the wave can start."
    Hint: ""
    Target: {x: 14, y: 8}
    Ghost:
    - Build: 9
      Cell: {x: 14, y: 8}
      Facing: 0
    Opens:
    StartsWave: 0
    Title: "Load the gun"
    Focus: 04
    Reveal: 0
    AddsOre: []
  - Step: 13
    Text: "Press N, or click START WAVE."
    Hint: ""
    Target: {x: 14, y: 8}
    Ghost:
    - Build: 9
      Cell: {x: 14, y: 8}
      Facing: 0
    Opens:
    StartsWave: 1
    Title: "Try your fix"
    Focus: 0a02
    Reveal: 0
    AddsOre: []
  - Step: 14
    Text: "Right shape, full damage. Keep the line running and clear this wave to finish."
    Hint: ""
    Target: {x: 14, y: 8}
    Ghost:
    - Build: 9
      Cell: {x: 14, y: 8}
      Facing: 0
    Opens:
    StartsWave: 0
    Title: "Defend"
    Focus: 0401
    Reveal: 0
    AddsOre: []
  TutorialCoached: 1
